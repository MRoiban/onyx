{
  "compilerOptions": {
    "target": "ES2020",
    "types": [
      "bun",
      "react",
      "react-dom"
    ],
    "module": "ESNext",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "gallery",
    "test"
  ]
}
