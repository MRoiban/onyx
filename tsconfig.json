{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node", "react", "react-dom", "vite/client"],
    "module": "ESNext",
    "lib": ["DOM", "ES2020"],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": ["./src"]
}
